# --- Required ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# --- Redis ---
# Local (docker-compose provides this automatically):
REDIS_URL=redis://localhost:6379/0
# Upstash (production): rediss://default:<password>@<name>.upstash.io:6379

# --- Optional overrides ---
# GEMINI_MODEL=gemini-2.5-flash
# REPORT_TTL_SECONDS=86400
# SANDBOX_TIMEOUT_SECONDS=90
# SANDBOX_MEMORY_MB=1536
# MAX_CODER_RETRIES=3
